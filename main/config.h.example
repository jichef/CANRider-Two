#ifndef CONFIG_H
#define CONFIG_H

// ════════════════════════════════════════════════════════════════════════
//  CONFIG.H — plantilla de configuración de CanRider
//  Copia este archivo como "config.h" (mismo directorio) y edita SOLO los
//  bloques marcados con >>> CAMBIA ESTO <<<. El resto no hace falta tocarlo.
//
//  config.h está en .gitignore y NUNCA debe subirse a git — aquí van tus
//  credenciales reales.
// ════════════════════════════════════════════════════════════════════════


// ┌──────────────────────────────────────────────────────────────────────┐
// │ >>> CAMBIA ESTO 1/5 — Qué placa tienes                                │
// └──────────────────────────────────────────────────────────────────────┘
// Las dos líneas empiezan comentadas a propósito: tienes que elegir tú,
// no hay una placa activa por defecto. Descomenta SOLO la línea de la
// tuya (quita el "//" de delante) y deja la otra comentada — si dejas
// las dos, o las dos descomentadas, el firmware no compila (a propósito).
//
//   SIM7000G → LilyGo T-SIM7000G — RECOMENDADA, es la que se ha probado
//              a fondo con moto real en este proyecto (LTE Cat-M1/NB-IoT,
//              menor consumo, GPS integrado).
//   A7670G   → LilyGo T-A7670G  (LTE Cat-1, más velocidad de datos, pero
//              el GPS de esta variante suele ser un módulo externo aparte
//              — revisa la guía si la usas).

// #define MODEM_A7670G
// #define MODEM_SIM7000G


// ┌──────────────────────────────────────────────────────────────────────┐
// │ >>> CAMBIA ESTO 2/5 — Tus datos de Supabase y del vehículo            │
// └──────────────────────────────────────────────────────────────────────┘
// SUPABASE_URL y SUPABASE_KEY: Supabase → tu proyecto → Project Settings
// → API. Usa la "anon public key", NUNCA la "service_role key".
// VEHICLE_ID: cualquier UUID único para esta moto — puedes generarlo en el
// SQL Editor de Supabase con: select gen_random_uuid();

#define SUPABASE_URL \
"https://XXXXXXXXXXXXXXXXXXXX.supabase.co"
#define SUPABASE_KEY \
"TU_SUPABASE_ANON_KEY_AQUI"
#define VEHICLE_ID "tu-uuid-de-vehiculo-aqui"


// ┌──────────────────────────────────────────────────────────────────────┐
// │ >>> CAMBIA ESTO 3/5 — APN de tu SIM                                   │
// └──────────────────────────────────────────────────────────────────────┘
// El APN lo da tu operador (búscalo como "APN <tu operador> IoT/M2M" o
// mira la web del operador de tu tarjeta SIM). Si tu SIM necesita usuario/
// contraseña (poco habitual), rellena GPRS_USER/GPRS_PASS también.

#define APN        "internet.tuoperadora.es"
#define GPRS_USER  ""
#define GPRS_PASS  ""


// ┌──────────────────────────────────────────────────────────────────────┐
// │ >>> CAMBIA ESTO 4/5 (solo si tu moto va a otra velocidad) — Bus CAN   │
// └──────────────────────────────────────────────────────────────────────┘
// Los pines ya están puestos correctamente para cada placa (no hace falta
// tocarlos salvo que tengas un cableado distinto). Lo único que sí varía
// según el vehículo es la VELOCIDAD del bus — pregunta a quien te haya
// pasado el protocolo CAN de tu moto, o pruébalo si no lo sabes.

#if defined(MODEM_A7670G)
  #define CAN_TX_PIN     22   // pines adyacentes del header T-A7670G,
  #define CAN_RX_PIN     21   // evita GPIO33 (RING del módem)
#elif defined(MODEM_SIM7000G)
  #define CAN_TX_PIN     32
  #define CAN_RX_PIN     33
#endif

//   TWAI_TIMING_CONFIG_500KBITS()  → 500 kbps (CAN automotriz estándar)
//   TWAI_TIMING_CONFIG_250KBITS()  → 250 kbps (J1939 / algunos vehículos eléctricos)
//   TWAI_TIMING_CONFIG_125KBITS()  → 125 kbps
#define CAN_SPEED        TWAI_TIMING_CONFIG_250KBITS()


// ════════════════════════════════════════════════════════════════════════
//  A partir de aquí no hace falta tocar nada — son solo los "#define" que
//  usa el resto del firmware para saber qué placa compilar.
// ════════════════════════════════════════════════════════════════════════

#if defined(MODEM_A7670G) && defined(MODEM_SIM7000G)
  #error "Solo puede estar descomentado UNO de MODEM_A7670G / MODEM_SIM7000G, no los dos"
#elif defined(MODEM_A7670G)
  #define LILYGO_T_A7670
#elif defined(MODEM_SIM7000G)
  #define LILYGO_SIM7000G
#else
  #error "Define MODEM_A7670G o MODEM_SIM7000G en config.h"
#endif

// ┌──────────────────────────────────────────────────────────────────────┐
// │ >>> OPCIONAL — Depuración AT en bruto (solo SIM7000G)                 │
// └──────────────────────────────────────────────────────────────────────┘
// Sin definir (por defecto): TinyGsm habla directo con el módem, sin
// pasos intermedios.
//
// Si la defines: cada byte AT real hacia/desde el módem se vuelca también
// por Serial (USB) vía StreamDebugger, para depurar en el banco qué está
// mandando/recibiendo TinyGsm de verdad. Cuesta caro en tiempo: la
// respuesta de una petición HTTPS (hasta MAX_HTTP_BODY bytes) se reenvía
// entera por USB de forma síncrona, byte a byte, duplicando el tiempo de
// lectura de cada POST y falseando cualquier medición de rendimiento que
// hagas con ella activa. Déjala comentada salvo que estés depurando el
// diálogo AT en el banco.

// #define DUMP_AT_COMMANDS

// ┌──────────────────────────────────────────────────────────────────────┐
// │ >>> CAMBIA ESTO 5/5 (solo si tu moto usa otras tramas) — Señales CAN  │
// └──────────────────────────────────────────────────────────────────────┘
// Frame ID (hexadecimal) y byte (0-7 dentro de la trama de 8 bytes) de
// cada señal. Solo hay 5: la hora que se envía al panel (nunca se toca
// nada más por CAN), el % de las dos baterías, y si está cargando.
//
// Estas 10 líneas empiezan comentadas (sin definir) a propósito — NO las
// rellenes con valores inventados ni copies los de otra moto. Tienes que
// averiguar los de tu propia moto (con un analizador CAN, documentación
// del fabricante, o ingeniería inversa) antes de descomentarlas.
//
// Cada señal es independiente: si dejas sin descomentar CAN_CLOCK_FRAME/
// HOUR_BYTE/MIN_BYTE, el firmware simplemente NO transmite ninguna trama
// de reloj (en vez de mandar una inventada al bus real). Si dejas sin
// descomentar una batería o CAN_CHARGING_*, esa lectura se omite y su
// dato en el portal queda vacío — el resto sigue funcionando igual.
//
// CAN_CHARGING_BITMASK es distinto a los demás: no es un byte completo,
// sino un bit dentro de ese byte (0x10 = bit 4). El firmware compara
// data[byte] & bitmask y guarda 1 si el bit está activo, 0 si no.
//
// El firmware (main/main.ino, setupCANSignals()) las lee de estas
// macros, no hace falta tocar el .ino para adaptar esto a tu vehículo. Si
// necesitas leer señales CAN adicionales que no sean estas 5, o cualquier
// trama TX nueva, eso sí requiere editar setupCANSignals() directamente
// en main.ino — a propósito, para que nunca se pueda añadir tráfico TX
// nuevo solo tocando un archivo de configuración.
//
// Así se escribiría un EJEMPLO (no lo copies, no es un vehículo real):
//   #define CAN_CLOCK_FRAME     0x200
//   #define CAN_CLOCK_HOUR_BYTE 0
//   #define CAN_CLOCK_MIN_BYTE  1
//   #define CAN_BATTERY_A_FRAME 0x300
//   #define CAN_BATTERY_A_BYTE  0
//   #define CAN_BATTERY_B_FRAME 0x301
//   #define CAN_BATTERY_B_BYTE  0
//   #define CAN_CHARGING_FRAME   0x302
//   #define CAN_CHARGING_BYTE    1
//   #define CAN_CHARGING_BITMASK 0x10

// #define CAN_CLOCK_FRAME
// #define CAN_CLOCK_HOUR_BYTE
// #define CAN_CLOCK_MIN_BYTE

// #define CAN_BATTERY_A_FRAME
// #define CAN_BATTERY_A_BYTE

// #define CAN_BATTERY_B_FRAME
// #define CAN_BATTERY_B_BYTE

// #define CAN_CHARGING_FRAME
// #define CAN_CHARGING_BYTE
// #define CAN_CHARGING_BITMASK


// ┌──────────────────────────────────────────────────────────────────────┐
// │ >>> OPCIONAL — WiFi preferente sobre LTE                              │
// └──────────────────────────────────────────────────────────────────────┘
// Sin rellenar (por defecto), esta función no existe.
//
// Si está definida, al arrancar el ESP32 busca estas redes conocidas
// (hasta 2, la segunda es opcional) antes que nada. Si conecta, la
// telemetría se manda por ahí (normalmente más barato en datos y más
// estable) en vez de por LTE. Si no hay ninguna al alcance, se usa LTE —
// y mientras la LTE vaya bien no se vuelve a buscar WiFi, para no andar
// cambiando de red sin necesidad. Solo si la LTE falla, o si la conexión
// WiFi que ya estaba activa se cae, se reintenta WiFi; si tampoco hay red
// al alcance en ese momento, se sigue con LTE.
//
// El guardado de viajes (inicio, checkpoints intermedios y cierre) también
// va por WiFi cuando está conectado, no solo la telemetría — postTripUpdate()
// intenta WiFi primero y solo cae a LTE si no hay WiFi conectado en ese
// momento. Si ninguno de los dos consigue mandarlo (p.ej. un viaje termina
// justo al perderse el WiFi y la LTE tampoco responde todavía), se guarda
// en pendingTripBody y se reintenta en el siguiente ciclo, por cualquiera
// de las dos vías — no se pierde.

// #define WIFI_FALLBACK_SSID_1 "tu-red-1"
// #define WIFI_FALLBACK_PASS_1 "contraseña-red-1"

// #define WIFI_FALLBACK_SSID_2 "tu-red-2"
// #define WIFI_FALLBACK_PASS_2 "contraseña-red-2"


// ┌──────────────────────────────────────────────────────────────────────┐
// │ >>> OPCIONAL — Actualización OTA automática al aparcar                │
// └──────────────────────────────────────────────────────────────────────┘
// Sin rellenar (por defecto), esta función no existe: el firmware no
// levanta ningún AP WiFi.
//
// Si defines una contraseña aquí: en cuanto el bus CAN se queda en
// silencio (moto apagada), se levanta un AP WiFi "CanRiderTwo" con esta
// contraseña — portal cautivo incluido: al conectarte, el propio móvil
// abre la página de actualización solo, como en un WiFi público (o entra
// a mano en http://192.168.4.1/) — con un botón para subir un .bin y otro
// para reiniciar el ESP32 en remoto. Sin Bluetooth ni ninguna app. El AP
// se apaga solo a los 4 min sin ninguna petición, o a los 2 min de que el
// último cliente conectado se vaya (lo que llegue antes), o de inmediato
// si la moto se enciende a mitad de la ventana. Si el WiFi de arriba ya
// está conectado para telemetría, no se interrumpe para levantar el AP.
//
// La misma página incluye un botón "Iniciar viaje (sin CAN)" — guarda un
// viaje por GPS (con sus waypoints) sin depender de ninguna trama CAN, para
// cuando el ESP32 no va montado en la moto (p.ej. en una bici). Se cierra
// solo (sin volver a tocar el botón) a los 5 min sin superar 5 km/h reales
// de GPS, así que no hace falta tener el móvil cerca del AP al terminar.
// Mientras está activo, el movimiento GPS no cuenta como posible
// sustracción (ver moving_without_can más abajo) — es intencional.
//
// Usa una contraseña propia de al menos 8 caracteres — es un secreto igual
// que SUPABASE_KEY, no la compartas ni la subas a git.

// #define OTA_AP_PASSWORD "cambia-esto-por-algo-tuyo"

#endif
